      "cell_type": "markdown",
      "source": [
        "# **Step 11 — Load Knowledge Base & Build FAISS Index**\n"
      ],
      "metadata": {
        "id": "V2US0JNL59v8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "with open(\"knowledge_base_yaqeen_v3.json\", \"r\", encoding=\"utf-8\") as f:\n",
        "    knowledge_base = json.load(f)\n",
        "\n",
        "print(f\"Knowledge base loaded — {len(knowledge_base)} records.\")\n",
        "\n",
        "# multilingual — works well with arabic\n",
        "embedding_model = SentenceTransformer(\n",
        "    \"sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2\"\n",
        ")\n",
        "print(\"Embedding model loaded.\")\n",
        "\n",
        "documents = []\n",
        "metadata  = []\n",
        "\n",
        "for item in knowledge_base:\n",
        "    keywords = \" \".join(item.get(\"keywords\", []))\n",
        "    combined = (\n",
        "        f\"المصدر: {item.get('source', '')}\\n\"\n",
        "        f\"الكلمات المفتاحية: {keywords}\\n\"\n",
        "        f\"الملخص: {item.get('summary', '')}\\n\"\n",
        "        f\"السياق: {item.get('rag_context', '')}\"\n",
        "    )\n",
        "    documents.append(combined)\n",
        "    metadata.append({\n",
        "        \"source\":            item.get(\"source\", \"\"),\n",
        "        \"credibility\":       item.get(\"credibility\", \"\"),\n",
        "        \"credibility_score\": float(item.get(\"credibility_score\", 0.0)),\n",
        "        \"url\":               item.get(\"url\", \"\"),\n",
        "        \"category\":          item.get(\"category\", \"\"),\n",
        "    })\n",
        "\n",
        "print(\"Generating embeddings...\")\n",
        "embeddings = embedding_model.encode(\n",
        "    documents,\n",
        "    convert_to_numpy=True,\n",
        "    show_progress_bar=True,\n",
        ")\n",
        "\n",
        "# cosine sim via normalized inner product\n",
        "dimension = embeddings.shape[1]\n",
        "faiss.normalize_L2(embeddings)\n",
        "index = faiss.IndexFlatIP(dimension)\n",
        "index.add(embeddings)\n",
        "\n",
        "print(f\"FAISS index built — {index.ntotal} vectors, dim={dimension}\")"
      ],

      "source": [
        "# **Step 6 — Evaluate on Test Set**\n"
      ],
      "metadata": {
        "id": "JrPPC-wX2Ajg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import (\n",
        "    classification_report,\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    roc_auc_score,\n",
        "    roc_curve,\n",
        ")\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "results = trainer.evaluate(test_dataset)\n",
        "\n",
        "predictions = trainer.predict(test_dataset)\n",
        "preds       = np.argmax(predictions.predictions, axis=-1)\n",
        "\n",
        "# prob of \"real\" class — needed for AUC\n",
        "probs = torch.softmax(\n",
        "    torch.tensor(predictions.predictions), dim=1\n",
        ")[:, 1].numpy()\n",
        "\n",
        "accuracy  = accuracy_score(test_labels, preds)\n",
        "f1        = f1_score(test_labels, preds, average='weighted')\n",
        "precision = precision_score(test_labels, preds, average='weighted')\n",
        "recall    = recall_score(test_labels, preds, average='weighted')\n",
        "auc_roc   = roc_auc_score(test_labels, probs)\n",
        "\n",
        "print(\"=\" * 45)\n",
        "print(\"         Model Evaluation Results\")\n",
        "print(\"=\" * 45)\n",
        "print(f\"  Accuracy  : {accuracy  * 100:.2f}%\")\n",
        "print(f\"  F1 Score  : {f1        * 100:.2f}%\")\n",
        "print(f\"  Precision : {precision * 100:.2f}%\")\n",
        "print(f\"  Recall    : {recall    * 100:.2f}%\")\n",
        "print(f\"  AUC-ROC   : {auc_roc   * 100:.2f}%\")\n",
        "print(\"=\" * 45)\n",
        "\n",
        "print(\"\\nDetailed Classification Report:\")\n",
        "print(classification_report(\n",
        "    test_labels,\n",
        "    preds,\n",
        "    target_names=[\"fake\", \"real\"]\n",
        "))\n",
        "\n",
        "fpr, tpr, _ = roc_curve(test_labels, probs)\n",
        "plt.figure(figsize=(7, 5))\n",
        "plt.plot(fpr, tpr, color='blue', label=f'AUC-ROC = {auc_roc:.4f}')\n",
        "plt.plot([0, 1], [0, 1], color='gray', linestyle='--', label='Random Classifier')\n",
        "plt.xlabel('False Positive Rate')\n",
        "plt.ylabel('True Positive Rate')\n",
        "plt.title('ROC Curve — CAMeL-BERT Fake News Detection')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],

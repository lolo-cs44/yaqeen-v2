        "id": "zmGqZ4ssrBp8"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "#**Step 1 — Install**"
      ],
      "metadata": {
        "id": "zvhzVq-ss49u"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1yy7ohM2seGG",
        "outputId": "0f33699d-61bb-45c1-81c4-6d0efa6f9000"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",

          ]
        }
      ],
      "source": [
        "!pip install -q transformers datasets torch scikit-learn\n",
        "\n",
        "import re\n",
        "import torch\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from datasets import load_dataset\n",
        "from transformers import (\n",
        "    AutoTokenizer,\n",
        "    AutoModelForSequenceClassification,\n",
        "    TrainingArguments,\n",
        "    Trainer,\n",
        ")\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "from torch.utils.data import Dataset\n",
        "\n",
        "print(\" All packages installed and imports done.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "#**Step 2 — Preprocessing & Load Data**"
      ],
      "metadata": {
        "id": "-ke9R5jbsz2c"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# clean arabic text before feeding to model\n",
        "def preprocess(text):\n",
        "    if not isinstance(text, str):\n",
        "        return ''\n",
        "    text = re.sub(r'http\\S+', '', text)                      # remove urls\n",
        "    text = re.sub('[إأآا]', 'ا', text)                      # إأآا → ا\n",
        "    text = re.sub('ة', 'ه', text)                           # ة → ه\n",
        "    text = re.sub('ى', 'ي', text)                           # ى → ي\n",
        "    text = re.sub('[ؤئ]', 'ء', text)                        # ؤئ → ء\n",
        "    text = re.sub(r'[\\u064B-\\u065F\\u0640]', '', text)       # remove tashkeel\n",
        "    text = re.sub(r'[^\\u0600-\\u06FF\\w\\s،؟!.]', '', text)    # arabic only\n",
        "    text = re.sub(r'\\s+', ' ', text).strip()\n",
        "    return text\n",
        "\n",
        "# dataset 1\n",
        "raw1 = load_dataset('Nahla-yasmine/arabic_fake_news')\n",
        "df1  = raw1['train'].to_pandas()\n",
        "df1['text']  = (df1['title'].fillna('') + ' ' + df1['text'].fillna('')).str.strip()\n",
        "df1['label'] = df1['label'].map({'real': 1, 'fake': 0})\n",
        "\n",
        "# dataset 2 — stance based\n",
        "raw2 = load_dataset('arbml/arastance')\n",
        "df2  = pd.concat([\n",
        "    raw2['train'].to_pandas(),\n",
        "    raw2['validation'].to_pandas(),\n",
        "    raw2['test'].to_pandas()\n",
        "], ignore_index=True)\n",
        "df2  = df2[df2['stance'].isin([0, 1])].copy()\n",
        "df2['text']  = (df2['claim'].fillna('') + ' ' + df2['article'].fillna('')).str[:512]\n",
        "df2['label'] = df2['stance'].map({0: 1, 1: 0})\n",
        "\n",
        "# balance classes — up to 20k per class\n",
        "all_real = pd.concat([df1[df1.label==1], df2[df2.label==1]]).drop_duplicates('text')\n",
        "all_fake = pd.concat([df1[df1.label==0], df2[df2.label==0]]).drop_duplicates('text')\n",
        "n  = min(20000, len(all_real), len(all_fake))\n",
        "df = pd.concat([\n",
        "    all_real.sample(n=n, random_state=42),\n",
        "    all_fake.sample(n=n, random_state=42)\n",
        "]).sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "\n",
        "df['text'] = df['text'].apply(preprocess)\n",
        "df = df[df['text'].str.len() > 10].reset_index(drop=True)\n",
        "\n",
        "print(f\"Total samples: {len(df)}\")\n",
        "print(f\"Label distribution:\\n{df['label'].value_counts()}\")"
      ],

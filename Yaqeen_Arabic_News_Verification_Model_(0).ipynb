      "cell_type": "markdown",
      "source": [
        "# **Step 12 — Build Full Verification System**\n"
      ],
      "metadata": {
        "id": "f4x7VY6J6LmF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def retrieve_sources(query: str, top_k: int = 3) -> list:\n",
        "    \"\"\"retrieve top-k by cosine similarity\"\"\"\n",
        "    top_k = min(top_k, index.ntotal)\n",
        "    if top_k == 0:\n",
        "        return []\n",
        "    q_emb = embedding_model.encode([query], convert_to_numpy=True)\n",
        "    faiss.normalize_L2(q_emb)\n",
        "    distances, indices_arr = index.search(q_emb, top_k)\n",
        "    results = []\n",
        "    for rank, idx in enumerate(indices_arr[0]):\n",
        "        if idx == -1:\n",
        "            continue\n",
        "        results.append({\n",
        "            \"rank\":             rank + 1,\n",
        "            \"source\":           metadata[idx][\"source\"],\n",
        "            \"credibility\":      metadata[idx][\"credibility\"],\n",
        "            \"credibility_score\":metadata[idx][\"credibility_score\"],\n",
        "            \"url\":              metadata[idx][\"url\"],\n",
        "            \"category\":         metadata[idx][\"category\"],\n",
        "            \"similarity\":       round(float(distances[0][rank]), 4),\n",
        "        })\n",
        "    return results\n",
        "\n",
        "def verify_news(news_text: str) -> dict:\n",
        "    \"\"\"classify then retrieve supporting sources\"\"\"\n",
        "\n",
        "    inputs = tokenizer(\n",
        "        news_text,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        padding=True,\n",
        "        max_length=256,\n",
        "    )\n",
        "    inputs = {k: v.to(model.device) for k, v in inputs.items()}\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**inputs)\n",
        "    probs        = torch.softmax(outputs.logits, dim=1)\n",
        "    predicted    = torch.argmax(probs, dim=1).item()\n",
        "    model_conf   = round(probs[0][predicted].item() * 100, 2)\n",
        "    prediction   = \"real\" if predicted == 1 else \"fake\"\n",
        "\n",
        "    retrieved = retrieve_sources(news_text, top_k=3)\n",
        "    best      = retrieved[0] if retrieved else {\n",
        "        \"source\": \"N/A\", \"credibility\": \"Unknown\",\n",
        "        \"credibility_score\": 0.0, \"url\": \"\"\n",
        "    }\n",
        "\n",
        "    source_conf = round(best[\"credibility_score\"] * 100, 2)\n",
        "    final_conf  = round(model_conf * 0.6 + source_conf * 0.4, 2)\n",
        "\n",
        "    reasons = {\n",
        "        \"real\": \"The claim matches trusted or official sources.\",\n",
        "        \"fake\": \"The claim appears unreliable or unsupported by trusted sources.\",\n",
        "    }\n",
        "\n",
        "    return {\n",
        "        \"claim\":            news_text,\n",
        "        \"prediction\":       prediction,\n",
        "        \"model_confidence\": model_conf,\n",
        "        \"source_confidence\":source_conf,\n",
        "        \"final_confidence\": final_conf,\n",
        "        \"reason\":           reasons[prediction],\n",
        "        \"best_source\":      best[\"source\"],\n",
        "        \"source_url\":       best[\"url\"],\n",
        "        \"related_sources\":  retrieved,\n",
        "    }\n",
        "\n",
        "print(\"done\")"
      ],

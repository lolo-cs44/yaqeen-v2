    {
      "cell_type": "markdown",
      "source": [
        "#**Step 14 — Improved Decision Logic**\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "id": "j8iTSfg26mBQ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def verify_news_v2(news_text: str) -> dict:\n",
        "\n",
        "    # same as v1 but weight shifts based on retrieval similarity\n",
        "    inputs = tokenizer(\n",
        "        news_text,\n",
        "        return_tensors=\"pt\",\n",
        "        truncation=True,\n",
        "        padding=True,\n",
        "        max_length=256,\n",
        "    )\n",
        "    inputs = {k: v.to(model.device) for k, v in inputs.items()}\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**inputs)\n",
        "    probs      = torch.softmax(outputs.logits, dim=1)\n",
        "    predicted  = torch.argmax(probs, dim=1).item()\n",
        "    model_conf = round(probs[0][predicted].item() * 100, 2)\n",
        "    prediction = \"real\" if predicted == 1 else \"fake\"\n",
        "\n",
        "    retrieved = retrieve_sources(news_text, top_k=3)\n",
        "    best      = retrieved[0] if retrieved else {\n",
        "        \"source\": \"N/A\", \"credibility\": \"Unknown\",\n",
        "        \"credibility_score\": 0.0, \"url\": \"\", \"similarity\": 0.0\n",
        "    }\n",
        "\n",
        "    source_conf = round(best[\"credibility_score\"] * 100, 2)\n",
        "    similarity  = best.get(\"similarity\", 0.0)\n",
        "\n",
        "\n",
        "    if similarity >= 0.6:\n",
        "        model_weight  = 0.4\n",
        "        source_weight = 0.6\n",
        "        if best[\"credibility_score\"] >= 0.8 and prediction == \"fake\":\n",
        "            prediction = \"real\"\n",
        "            reason     = f\"Overridden: highly relevant trusted source found ({best['source']}).\"\n",
        "        else:\n",
        "            reason = \"The claim matches trusted or official sources.\" if prediction == \"real\" \\\n",
        "                else \"The claim appears unreliable or unsupported by trusted sources.\"\n",
        "    else:\n",
        "        model_weight  = 0.7\n",
        "        source_weight = 0.3\n",
        "        reason = \"The claim matches trusted or official sources.\" if prediction == \"real\" \\\n",
        "            else \"The claim appears unreliable or unsupported by trusted sources.\"\n",
        "\n",
        "    final_conf = round(model_conf * model_weight + source_conf * source_weight, 2)\n",
        "\n",
        "    return {\n",
        "        \"claim\":            news_text,\n",
        "        \"prediction\":       prediction,\n",
        "        \"model_confidence\": model_conf,\n",
        "        \"source_confidence\":source_conf,\n",
        "        \"similarity\":       round(similarity, 4),\n",
        "        \"final_confidence\": final_conf,\n",
        "        \"reason\":           reason,\n",
        "        \"best_source\":      best[\"source\"],\n",
        "        \"source_url\":       best[\"url\"],\n",
        "        \"related_sources\":  retrieved,\n",
        "    }\n",
        "\n",
        "print(\"done\")"
      ],

      "source": [
        "# **Step 16 — Fixed Country Detection**\n"
      ],
      "metadata": {
        "id": "O2VcVdVl7Fhw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "SOURCE_KEYWORDS_MAP = {\n",
        "    \"وكالة الأنباء السعودية (SPA)\": [\n",
        "        \"عام /\", \"خاص /\", \"حج /\", \"رياضة /\", \"اقتصاد /\",\n",
        "        \"سياسي /\", \"ثقافة /\", \"صحة /\", \"أمن /\",\n",
        "        \"SPA\", \"واس\", \"وكالة الأنباء\",\n",
        "        \"خادم الحرمين الشريفين\", \"خادم الحرمين\",\n",
        "        \"الملك سلمان\", \"ولي العهد\", \"محمد بن سلمان\",\n",
        "        \"أمر ملكي\", \"مرسوم ملكي\", \"الديوان الملكي\",\n",
        "    ],\n",
        "    \"وزارة الصحة السعودية\": [\n",
        "        \"وزارة الصحة\", \"الصحة السعودية\",\n",
        "        \"المتحدث باسم الصحة\", \"مستشفى\", \"وباء\", \"لقاح\",\n",
        "    ],\n",
        "    \"وزارة التعليم السعودية\": [\n",
        "        \"وزارة التعليم\", \"التعليم السعودي\",\n",
        "        \"المتحدث باسم التعليم\", \"مدارس\", \"طلاب\", \"جامعة\",\n",
        "    ],\n",
        "    \"وزارة الدفاع السعودية\": [\n",
        "        \"وزارة الدفاع\", \"القوات المسلحة\", \"الجيش السعودي\",\n",
        "        \"الدفاع الجوي\", \"الحرس الوطني\", \"اعتراض\",\n",
        "        \"مسيّرات\", \"صواريخ\", \"المجال الجوي\",\n",
        "    ],\n",
        "    \"وزارة الداخلية السعودية\": [\n",
        "        \"وزارة الداخلية\", \"الأمن العام\", \"شرطة\",\n",
        "        \"المديرية العامة للجوازات\", \"الإقامة\", \"الجنسية\",\n",
        "    ],\n",
        "    \"وزارة الحج والعمرة\": [\n",
        "        \"وزارة الحج\", \"موسم الحج\", \"تصاريح الحج\",\n",
        "        \"طريق مكة\", \"الحجاج\", \"بعثة الحج\", \"المعتمرون\",\n",
        "    ],\n",
        "    \"الرئاسة العامة للحرمين الشريفين\": [\n",
        "        \"المسجد الحرام\", \"المسجد النبوي\",\n",
        "        \"خدمات الحرم\", \"الطواف\", \"الكعبة\",\n",
        "        \"الصفا والمروة\", \"منى\", \"عرفات\",\n",
        "    ],\n",
        "    \"وزارة الطاقة السعودية\": [\n",
        "        \"وزارة الطاقة\", \"أرامكو\", \"النفط السعودي\",\n",
        "        \"أوبك\", \"الغاز الطبيعي\", \"الطاقة المتجددة\",\n",
        "    ],\n",
        "    \"هيئة الطيران المدني\": [\n",
        "        \"هيئة الطيران\", \"المطار\", \"الطيران المدني\",\n",
        "        \"مطار الملك\", \"مطار الأمير\",\n",
        "    ],\n",
        "    \"وزارة الرياضة السعودية\": [\n",
        "        \"وزارة الرياضة\", \"الهلال\", \"النصر\", \"الاتحاد\",\n",
        "        \"الأهلي\", \"الدوري السعودي\", \"دوري روشن\",\n",
        "        \"كأس الملك\", \"الاتحاد السعودي لكرة القدم\",\n",
        "    ],\n",
        "}\n",
        "\n",
        "def detect_source(text: str) -> str | None:\n",
        "    for source, keywords in SOURCE_KEYWORDS_MAP.items():\n",
        "        if any(k in text for k in keywords):\n",
        "            return source\n",
        "    return None\n",
        "\n",
        "def is_saudi_related(text: str) -> bool:\n",
        "    saudi_keywords = [\n",
        "        \"السعودية\", \"سعودي\", \"المملكة\", \"الرياض\", \"جدة\", \"مكة\", \"المدينة\",\n",
        "        \"خادم الحرمين الشريفين\", \"ولي العهد\", \"الملك سلمان\", \"محمد بن سلمان\",\n",
        "    ]\n",
        "    return any(k in text for k in saudi_keywords) or bool(detect_source(text))\n",
        "\n",
        "def verify_news_v3(news_text: str) -> dict:\n",
        "\n",
        "    # scope check first\n",
        "    if not is_saudi_related(news_text):\n",
        "        return {\n",
        "            \"claim\":            news_text,\n",
        "            \"prediction\":       \"out_of_scope\",\n",
        "            \"model_confidence\": 0.0,\n",
        "            \"source_confidence\":0.0,\n",
        "            \"final_confidence\": 0.0,\n",
        "            \"reason\":           \"This news is outside the system scope. The system only covers Saudi Arabian news.\",\n",
        "            \"best_source\":      \"N/A\",\n",
        "            \"source_url\":       \"\",\n",
        "            \"related_sources\":  [],\n",
        "        }\n",
        "\n",
        "    detected_source = detect_source(news_text)\n",
        "\n",
        "        # trusted source in text → skip model\n",
        "    if detected_source:\n",
        "        retrieved = retrieve_sources(news_text, top_k=3)\n",
        "        return {\n",
        "            \"claim\":            news_text,\n",
        "            \"prediction\":       \"real\",\n",
        "            \"model_confidence\": 100.0,\n",
        "            \"source_confidence\":100.0,\n",
        "            \"final_confidence\": 100.0,\n",
        "            \"reason\":           f\"Trusted source detected directly: {detected_source}\",\n",
        "            \"best_source\":      detected_source,\n",
        "            \"source_url\":       next((m[\"url\"] for m in metadata if detected_source in m[\"source\"]), \"\"),\n",
        "            \"related_sources\":  retrieved,\n",
        "        }\n",
        "\n",
        "    return verify_news_v2(news_text)\n",
        "\n",
        "print(\"v3 ready\")"
      ],
